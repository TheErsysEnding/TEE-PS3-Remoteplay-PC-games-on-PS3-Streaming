+    /* TEE: cyclic intra refresh. Each P-picture codes the next band of macroblock rows as intra, so
+     * after one sweep every part of the picture has been renewed without a whole I-picture - no size
+     * spike, and a stream that lost data heals by itself within one sweep.
+     * The rows above the band were renewed earlier in this sweep and are the "clean" part; they may
+     * only predict from the clean part of the previous picture (rows above the band as well), or a
+     * lost picture's damage is dragged straight back into them. A vector reaching lower is not
+     * allowed, and that macroblock is coded intra instead. MPEG-1/2 vectors are half-pel. */
+    if (m->intra_refresh > 0) {
+        if (s->c.pict_type == AV_PICTURE_TYPE_I) {
+            m->intra_refresh_pos = 0;
+        } else if (s->c.pict_type == AV_PICTURE_TYPE_P) {
+            int period = FFMIN(m->intra_refresh, s->c.mb_height);
+            int band   = m->intra_refresh_pos % period;
+            int first  = band * s->c.mb_height / period;
+            int last   = (band + 1) * s->c.mb_height / period;
+            for (int y = 0; y < last; y++) {
+                for (int x = 0; x < s->c.mb_width; x++) {
+                    int xy = x + y * s->c.mb_stride;
+                    if (y < first) {
+                        int my   = s->p_mv_table[xy][1];
+                        int myc  = my / 2;
+                        int luma = y * 16 + 15 + (my  >> 1) + (my  & 1);
+                        int chro = y *  8 +  7 + (myc >> 1) + (myc & 1);
+                        if ((s->mb_type[xy] & CANDIDATE_MB_TYPE_INTRA) ||
+                            (luma < first * 16 && chro < first * 8))
+                            continue;
+                    }
+                    s->mb_type[xy] = CANDIDATE_MB_TYPE_INTRA;
+                }
+            }
+            m->intra_refresh_pos = band + 1;
+        }
+    }
+
     ret = estimate_qp(m, 0);
     if (ret < 0)
         return ret;
